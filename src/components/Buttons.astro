---
import type { Banner } from '../consts'

interface Props {
  items: Banner[]
}

const { items } = Astro.props
---

<div class='buttons'>
  {
    items.map(b => (
      <a href={b.href} target='_blank' rel='noopener noreferrer'>
        {b.imgDark ? (
          <>
            <img
              class='theme-light'
              src={b.img}
              width='88'
              height='31'
              loading='lazy'
            />
            <img
              class='theme-dark'
              src={b.imgDark}
              width='88'
              height='31'
              loading='lazy'
            />
          </>
        ) : (
          <img src={b.img} width='88' height='31' loading='lazy' />
        )}
      </a>
    ))
  }
</div>
